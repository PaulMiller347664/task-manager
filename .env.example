# Copy to .env and adjust per environment.
# Docker Compose reads this file automatically for ${VAR} substitution.

# Database (SQLite today — User/Password reserved for a future server DB)
DB_PATH=/app/data
DB_NAME=app.db
DB_USER=
DB_PASSWORD=

# Auth
JWT_KEY=CHANGE_ME_super_secret_dev_signing_key_at_least_32_chars_long

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend build-time API URL
VITE_API_URL=http://localhost:8080/api
