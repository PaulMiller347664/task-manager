{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "Path": "data",
    "Name": "app.db"
  },
  "Jwt": {
    "Key": "CHANGE_ME_super_secret_dev_signing_key_at_least_32_chars_long",
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Client",
    "ExpiryHours": 24
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
